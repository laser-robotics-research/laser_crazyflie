{# livox_lidar_macro {--> #}
{%- macro livox_lidar_macro(namespace, parent_link, sensor_name, rot_freq, lasers, max_range, noise, x, y, z, roll, pitch, yaw) -%}
{# -- frame names -- #}
{%- set frame_fcu = "fcu" -%}
{%- set frame_sensor = sensor_name + "_sensor" -%}
{%- set frame_lidar = sensor_name + "_lidar"  -%}

{# -- topics -- #}
{%- set topic_lidar = sensor_name + "/lidar" -%}

{# -- tf from sensor to lidar -- #}
{%- set lidar_x = 0 -%}
{%- set lidar_y = 0 -%}
{%- set lidar_z = 0.05 -%}
{%- set lidar_roll = 0 -%}
{%- set lidar_pitch = 0 -%}
{%- set lidar_yaw = 0 -%}

  <link name="{{namespace}}_{{ sensor_name }}_link">
  <pose>{{ x }} {{ y }} {{ z }} {{ roll }} {{ pitch }} {{ yaw }}</pose>
  {{ zero_inertial_macro() }}

  <collision name="lidar_collision">
    <geometry>
      <mesh>
        <uri>model://laser_uavs_description/meshes/sensors/livox_mid_360.stl</uri>
        <scale>1 1 1</scale>
      </mesh>
    </geometry>
  </collision>
  
  <visual name="lidar_visual">
    <geometry>
      <mesh>
        <uri>model://laser_uavs_description/meshes/sensors/livox_mid_360.stl</uri>
        <scale>1 1 1</scale>
      </mesh>
    </geometry>
  </visual>

  <sensor name="{{namespace}}/{{ sensor_name }}_lidar_sensor" type="ray">
    <pose>{{ lidar_x }} {{ lidar_y }} {{ lidar_z }} {{ lidar_roll }} {{ lidar_pitch }} {{ lidar_yaw }}</pose>
    <visualize>false</visualize>
    <always_on>true</always_on>
    <update_rate>{{ rot_freq }}</update_rate>
    
    <plugin name="{{namespace}}_{{ sensor_name }}_lidar_plugin" filename="libLivoxPluginGazebo.so">
      <ray>
        <scan>
          <horizontal>
            <samples>{{lasers}}</samples> 
            <resolution>1</resolution>
            <min_angle>-3.1415926535897931</min_angle>
            <max_angle>3.1415926535897931</max_angle>
          </horizontal>
          <vertical>
            <samples>{{lasers}}</samples> 
            <resolution>1</resolution>
            <min_angle>-0.785398</min_angle>
            <max_angle>1.5708</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>{{ max_range }}</max>
          <resolution>1</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>{{ noise }}</stddev>
        </noise>
      </ray>
      
      <visualize>false</visualize>
      <samples>20000</samples>
      <downsample>30</downsample>
      <csv_file_name>mid360-real-centr.csv</csv_file_name>
      <publish_pointcloud_type>2</publish_pointcloud_type>
      <robot_namespace>{{ namespace }}</robot_namespace>
      <parent_frame_name>fcu</parent_frame_name>
      <sensor_frame_name>{{ sensor_name }}/link</sensor_frame_name>
      <sensor_x>{{ x }}</sensor_x>
      <sensor_y>{{ y }}</sensor_y>
      <sensor_z>{{ z }}</sensor_z>
      <sensor_roll>{{ roll }}</sensor_roll>
      <sensor_pitch>{{ pitch }}</sensor_pitch>
      <sensor_yaw>{{ yaw }}</sensor_yaw>
      <lidar_frame_name>{{ sensor_name }}/lidar</lidar_frame_name>
      <topic_lidar_name>{{ topic_lidar }}</topic_lidar_name>
      <lidar_x>{{ lidar_x }}</lidar_x>
      <lidar_y>{{ lidar_y }}</lidar_y>
      <lidar_z>{{ lidar_z }}</lidar_z>
      <lidar_roll>{{ lidar_roll }}</lidar_roll>
      <lidar_pitch>{{ lidar_pitch }}</lidar_pitch>
      <lidar_yaw>{{ lidar_yaw }}</lidar_yaw>
      <imu_frame_name>{{ sensor_name }}/imu</imu_frame_name>
      <imu_x>0</imu_x>
      <imu_y>0</imu_y>
      <imu_z>0</imu_z>
      <imu_roll>0</imu_roll>
      <imu_pitch>0</imu_pitch>
      <imu_yaw>0</imu_yaw>
    </plugin>
  </sensor>
</link>

<joint name="{{ sensor_name }}_joint" type="fixed">
  <parent>{{ parent_link }}</parent>
  <child>{{namespace}}_{{ sensor_name }}_link</child>
</joint>
{%- endmacro -%}
{# <!--}--> #}

