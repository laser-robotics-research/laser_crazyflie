{# imu_sensor_macro {--> #}
{%- macro imu_sensor_macro(namespace, sensor_name, parent_link, update_rate, topic_name, noise_mean, x, y, z, roll, pitch, yaw) -%}
  <link name="{{ namespace }}_{{ sensor_name }}_link">
    <pose relative_to = "{{ namespace }}_{{ parent_link }}_link">{{ x }} {{ y }} {{ z }} {{ roll }} {{ pitch }} {{ yaw }}</pose>
    {{ zero_inertial_macro() }}
    <sensor name="{{ namespace }}/{{ sensor_name }}_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>{{ update_rate }}</update_rate>
      <gravity>true</gravity>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>{{ noise_mean }}</mean>
              <stddev>2e-4</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>{{ noise_mean }}</mean>
              <stddev>2e-4</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>{{ noise_mean }}</mean>
              <stddev>2e-4</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>{{ noise_mean }}</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>{{ noise_mean }}</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>{{ noise_mean }}</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin name="{{ namespace }}_{{ sensor_name }}_plugin" filename="libImuPluginGazebo.so">
        <ros>
          <remapping>~/out:={{ topic_name }}</remapping>
        </ros>
        <robot_namespace>{{ namespace }}</robot_namespace>
        <parent_frame_name>{{ parent_link }}</parent_frame_name>
      </plugin>
    </sensor>
  </link>

  <joint name="{{ namespace }}_{{ sensor_name }}_joint" type="fixed">
    <parent>{{ namespace }}_{{ parent_link }}_link</parent>
    <child>{{ namespace }}_{{ sensor_name }}_link</child>
  </joint>
{%- endmacro -%}
{# <!--}--> #}

