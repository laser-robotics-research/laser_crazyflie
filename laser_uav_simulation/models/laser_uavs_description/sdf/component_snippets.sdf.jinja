{# gazebo_garmin_macro {--> #}
{%- macro gazebo_garmin_macro(garmin_name, lidar_topic, parent_link, max_distance, min_distance, update_rate, x, y, z, yaw) -%}
<link name="{{ garmin_name }}_link">
  <pose>{{ x }} {{ y }} {{ z }} 0 0 0</pose>
  {{ zero_inertial_macro() }}
    {{ visual_mesh_macro("{{ garmin_name }}_visual", "model://laser_uavs_description/meshes/sensors/garmin.stl", '0.001 0.001 0.001', "Black", 0, 0, -0.05, yaw, 1.57, 0) }}
  <sensor name="{{garmin_name}}_laser" type="ray">
    <pose>0 0 0 0 1.57079633 0</pose>
    <ray>
      <scan>
        <horizontal>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>-0.02</min_angle>
          <max_angle>0.02</max_angle>
        </horizontal>
        <vertical>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>-0.02</min_angle>
          <max_angle>0.02</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.06</min> <!-- do not change: use min_distance (below) for realistic behavior (smaller values cause issues) -->
        <max>35</max>   <!-- do not change: use min_distance (below) for realistic behavior (bigger values cause issues) -->
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.02</stddev>
      </noise>
    </ray>
    <plugin name="lidar_sensor" filename="libLidarPluginGazebo.so">
      <robotNamespace></robotNamespace>
      <min_distance>{{ min_distance }}</min_distance>
      <max_distance>{{ max_distance }}</max_distance>
      <topic>{{ lidar_topic }}</topic>
    </plugin>
    <always_on>1</always_on>
    <update_rate>{{ update_rate }}</update_rate>
    <visualize>true</visualize>
  </sensor>
</link>
<joint name='{{ garmin_name }}_joint' type='fixed'>
  <child>{{ garmin_name }}_link</child>
  <parent>{{ parent_link }}</parent>
</joint>
{%- endmacro -%}
