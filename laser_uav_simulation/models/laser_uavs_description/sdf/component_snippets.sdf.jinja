<!-- load_pendulum {-->
{%- macro load_pendulum(name, parent_link, attach_linker_pose, attach_linker_mass, rope_num_segments, rope_segment_length, rope_segment_radius, rope_segment_mass, load_mass) -%}
  <!-- rope_attacher {-->
  <link name="{{ name }}_link">
    <pose>0 0 0 0 0 0</pose> 
    <inertial>
      <mass>{{ attach_linker_mass }}</mass>
      <inertia>
        <ixx>0.0001</ixx> <ixy>0</ixy> <ixz>0</ixz>
        <iyy>0.0001</iyy> <iyz>0</iyz> <izz>0.0001</izz>
      </inertia>
    </inertial>
    <visual name="visual">
      <pose>0 0 -0.025 0 0 0</pose>
      <geometry>
        <cylinder>
          <length>0.05</length>
          <radius>0.005</radius>
        </cylinder>
      </geometry>
      <material><script><name>Gazebo/Gray</name></script></material>
    </visual>
    <collision name="collision">
      <pose>0 0 -0.025 0 0 0</pose>
      <geometry>
        <cylinder>
          <length>0.05</length>
          <radius>0.005</radius>
        </cylinder>
      </geometry>
    </collision>
  </link>

  <joint name="{{ name }}_joint" type="fixed">
    <parent>{{ parent_link }}</parent>
    <child>{{ name }}_link</child>
    <pose>{{ joint_pose }}</pose>
  </joint>
  <!--}-->

  <!-- rope {-->
  {%- set joint_damping = 0.5 -%}
  {%- for i in range(1, rope_num_segments + 1) -%}

    {%- if i == 1 -%}
    {%- set current_parent =  name ~ '_link' -%}
      {%- set joint_to_parent_pose = '0 0 ' ~ 0.0 ~ ' 0 0 0' -%}
    {%- else -%}
      {%- set current_parent = 'stretch_rope_link_' ~ (i-1) -%}
      {%- set joint_to_parent_pose = '0 0 ' ~ (-rope_segment_length) ~ ' 0 0 0' -%}
    {%- endif -%}

    <link name="stretch_rope_intermediate_link_{{ i }}">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>{{ rope_segment_mass / 100.0 }}</mass>
        <inertia><ixx>1e-8</ixx><iyy>1e-8</iyy><izz>1e-8</izz></inertia>
      </inertial>
    </link>

    <joint name="stretch_rope_joint1_{{ i }}" type="revolute">
      <pose>{{ joint_to_parent_pose }}</pose>
      <parent>{{ current_parent }}</parent>
      <child>stretch_rope_intermediate_link_{{ i }}</child>
      <axis><xyz>1 0 0</xyz></axis>
      <dynamics><damping>{{ joint_damping }}</damping></dynamics>
    </joint>

    <link name="stretch_rope_link_{{ i }}">
      <pose>0 0 0 0 0 0</pose> 
      <inertial>
        <mass>{{ rope_segment_mass }}</mass>
        <pose>0 0 {{ -rope_segment_length / 2.0 }} 0 0 0</pose>
        <inertia>
          <ixx>{{ (rope_segment_mass / 12.0) * (3 * rope_segment_radius * rope_segment_radius + rope_segment_length * rope_segment_length) }}</ixx>
          <iyy>{{ (rope_segment_mass / 12.0) * (3 * rope_segment_radius * rope_segment_radius + rope_segment_length * rope_segment_length) }}</iyy>
          <izz>{{ (rope_segment_mass / 2.0) * (rope_segment_radius * rope_segment_radius) }}</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <pose>0 0 {{ -rope_segment_length / 2.0 }} 0 0 0</pose>
        <geometry><cylinder><length>{{ rope_segment_length }}</length><radius>{{ rope_segment_radius }}</radius></cylinder></geometry>
        <material><script><name>Gazebo/Blue</name></script></material>
      </visual>
      <collision name="collision">
        <pose>0 0 {{ -rope_segment_length / 2.0 }} 0 0 0</pose>
        <geometry><cylinder><length>{{ rope_segment_length }}</length><radius>{{ rope_segment_radius }}</radius></cylinder></geometry>
        <self_collide>true</self_collide>
      </collision>
    </link>

    <joint name="stretch_rope_joint2_{{ i }}" type="revolute">
      <pose>0 0 0 0 0 0</pose> 
      <parent>stretch_rope_intermediate_link_{{ i }}</parent>
      <child>stretch_rope_link_{{ i }}</child>
      <axis><xyz>0 1 0</xyz></axis>
      <dynamics><damping>{{ joint_damping }}</damping></dynamics>
    </joint>
  {%- endfor -%}
  <!--}-->

  <!-- load {-->
  <link name="load_link">
    <pose>0 0 0 0 0 0</pose> 
    <inertial>
      <mass>{{ load_mass }}</mass> 
      <inertia> 
        <ixx>0.0000417</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>0.0000417</iyy><iyz>0</iyz><izz>0.0000417</izz>
      </inertia>
    </inertial>
    <visual name="load_visual">
      <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
      <material><script><name>Gazebo/Blue</name></script></material>
    </visual>
    <collision name="load_collision">
      <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
    </collision>
  </link>

  <joint name="load_joint" type="ball">
    <parent>stretch_rope_link_{{ rope_num_segments }}</parent>
    <child>load_link</child>
    <pose>0 0 -0.03 0 0 0</pose>
  </joint>
  <!--}-->
{%- endmacro -%}
<!--}-->
      
